{
    "name": "linkpulse",
    "version": "0.0.0",
    "private": true,
    "description": "URL shortener in TypeScript on Node.js, built phase by phase to learn backend and cloud engineering",
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": ">=26"
    },
    "imports": {
        "#src/*": "./src/*",
        "#test/*": "./test/*"
    },
    "scripts": {
        "start": "node src/main.ts",
        "dev": "node --watch src/main.ts",
        "db:ping": "node src/commands/db-ping.ts",
        "typecheck": "tsc",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "lint:api": "redocly lint --format=stylish",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "check": "npm run format:check && npm run lint && npm run lint:api && npm run typecheck && npm run test"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@redocly/cli": "2.78.0",
        "@types/express": "5.0.6",
        "@types/node": "26.6.6",
        "eslint": "10.14.0",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.10.1",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.2",
        "vitest": "5.1.0"
    },
    "dependencies": {
        "express": "5.3.0",
        "mongoose": "9.12.1"
    }
}
