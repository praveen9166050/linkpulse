# Copy this file to .env and fill in real values. .env is git-ignored; this
# file is committed so everyone knows which variables LinkPulse needs.

# Required. MongoDB Atlas connection string for a least-privilege user
# (readWrite on the databases below only). Atlas: Clusters > Connect > Drivers.
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster-host>/?retryWrites=true&w=majority

# Required. The database the app uses (tests use linkpulse_test).
MONGODB_DATABASE=linkpulse_dev

# Optional. Port to listen on (default 3000).
# PORT=3000

# Optional. The public address used to build short URLs (default: where the
# server listens, such as http://127.0.0.1:3000).
# PUBLIC_BASE_URL=https://lnkp.dev

# Optional. Comma-separated origins whose pages may call the API from a browser
# (CORS), e.g. the dashboard. Exact origins only: no paths, never "*".
# CORS_ORIGINS=http://localhost:3001

# Optional. "true" turns on dev-only endpoints, such as the live request stream
# at /api/v1/dev/requests. Never enable in production. Default false.
# DEV_TOOLS=true
